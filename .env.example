# Frontend (Vite + React) — copy ไปเป็น `.env` สำหรับรันในเครื่อง
# ไฟล์ `.env` ถูก gitignore (ไม่ขึ้น Git) ส่วนบน GitHub Pages ใช้ค่าจาก
# deploy.yml (vars.VITE_API_BASE_URL หรือ fallback https://unfitting-discount-lantern.ngrok-free.dev/htdocs/api)

# Backend API ที่ frontend จะยิงไป
# - ต่อ backend ผ่าน ngrok tunnel: https://unfitting-discount-lantern.ngrok-free.dev/htdocs/api
#   (Herd/php -S เสิร์ฟโฟลเดอร์ infinityfree_package แล้วเปิด ngrok มาที่พอร์ตนั้น)
# - ต่อ backend local ตรง: http://localhost:8000/htdocs/api
VITE_API_BASE_URL=https://unfitting-discount-lantern.ngrok-free.dev/htdocs/api
