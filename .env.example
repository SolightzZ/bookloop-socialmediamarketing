# Frontend (Vite + React) — copy ไปเป็น `.env` สำหรับรันในเครื่อง
# ไฟล์ `.env` ถูก gitignore (ไม่ขึ้น Git) ส่วนบน GitHub Pages ใช้ค่าจาก
# deploy.yml (vars.VITE_API_BASE_URL หรือ fallback https://unfitting-discount-lantern.ngrok-free.dev/api)

# Backend API ที่ frontend จะยิงไป
# - ต่อ backend ผ่าน ngrok tunnel: https://unfitting-discount-lantern.ngrok-free.dev/api
#   (รัน php -S ในเครื่องแล้วเปิด ngrok มาที่โฟลเดอร์ infinityfree_package/htdocs)
# - ต่อ backend local (php -S localhost:8000 -t infinityfree_package/htdocs): http://localhost:8000/api
VITE_API_BASE_URL=https://unfitting-discount-lantern.ngrok-free.dev/api
