# Frontend (Vite + React) — copy ไปเป็น `.env` สำหรับรันในเครื่อง
# ไฟล์ `.env` ถูก gitignore (ไม่ขึ้น Git) ส่วนบน GitHub Pages ใช้ค่าจาก
# deploy.yml (vars.VITE_API_BASE_URL หรือ fallback https://panitijahem.xo.je/api)

# Backend API ที่ frontend จะยิงไป
# - ต่อ backend จริงบน InfinityFree: https://panitijahem.xo.je/api
# - ต่อ backend local (php -S localhost:8000 -t src_backend): http://localhost:8000/api
VITE_API_BASE_URL=https://panitijahem.xo.je/api
