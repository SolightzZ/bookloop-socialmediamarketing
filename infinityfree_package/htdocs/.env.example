# Gmail SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Mail timeout in seconds - keep below PHP max_execution_time of 30
MAIL_TIMEOUT=15

# Sender Info
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BookLoop

# CORS - ใส่ origin ล้วน รูปแบบ scheme://host:port หลายตัวคั่นด้วย comma ห้ามใส่ path/slash ปิดท้าย
# เบราว์เซอร์ส่ง Origin แค่ scheme://host:port เช่น https://solightzz.github.io ไม่มี sub-path ของ repo
# รองรับ wildcard เช่น https://*.github.io แต่ห้ามใช้ * คู่กับ credentials ของ frontend
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://solightzz.github.io,https://panitijahem.xo.je

# File Storage
SUBSCRIBERS_FILE=subscribers.txt
ACTIVITIES_FILE=activities.txt
LOG_FILE=error.log
REQUEST_LOG_FILE=request.log

# Image Generation
TEMPLATE_IMAGE=images/template.png
FONT_PATH=images/fonts/NotoSansThai.ttf
GENERATED_IMAGES_PATH=images/generated
