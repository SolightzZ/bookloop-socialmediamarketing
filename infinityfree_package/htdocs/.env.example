# Gmail SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Mail timeout in seconds (PHPMailer Timeout) - keep below PHP max_execution_time (30)
MAIL_TIMEOUT=15

# Sender Info
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=BookLoop

# CORS - รองรับหลาย origin คั่นด้วย comma (ใส่ origin ของ frontend ทุกตัวที่ยิงมาที่ backend)
# เช่น localhost, IP บน LAN, และ GitHub Pages ตอน deploy
ALLOWED_ORIGIN=http://localhost:3000,http://192.168.1.5:3000

# File Storage
SUBSCRIBERS_FILE=subscribers.txt
ACTIVITIES_FILE=activities.txt
LOG_FILE=error.log
REQUEST_LOG_FILE=request.log

# Image Generation
TEMPLATE_IMAGE=images/template.png
FONT_PATH=images/fonts/NotoSansThai.ttf
GENERATED_IMAGES_PATH=images/generated
